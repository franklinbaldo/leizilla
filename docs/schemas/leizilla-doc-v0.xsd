      <xs:element ref="sec"/>
      <xs:element ref="subsec"/>
      <xs:element ref="art"/>
      <xs:element ref="ruido"/>
      <xs:element ref="ref"/>
      <xs:element ref="nota"/>
    </xs:choice>
    <xs:attribute name="n" type="Numero" use="required"/>
    <xs:attribute name="sufixo" type="Sufixo" use="optional"/>
    <xs:attribute name="lido-por" type="xs:token" use="optional"/>
    <xs:attribute name="corrigido" type="xs:boolean" use="optional"/>
    <xs:attribute name="estado" type="Estado" use="optional"/>
