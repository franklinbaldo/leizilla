      <xs:element ref="parte"/>
      <xs:element ref="liv"/>
      <xs:element ref="tit"/>
      <xs:element ref="cap"/>
      <xs:element ref="sec"/>
      <xs:element ref="subsec"/>
      <xs:element ref="art"/>
      <xs:element ref="par"/>
      <xs:element ref="inc"/>
      <xs:element ref="ali"/>
      <xs:element ref="item"/>
      <xs:element ref="ruido"/>
      <xs:element ref="ref"/>
      <xs:element ref="nota"/>
    </xs:choice>
    <xs:attribute name="alvo" type="xs:token" use="optional"/>
    <xs:attribute name="acao" type="xs:token" use="optional"/>
  </xs:complexType>
