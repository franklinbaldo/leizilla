      <xs:element ref="tit"/>
      <xs:element ref="cap"/>
      <xs:element ref="sec"/>
      <xs:element ref="subsec"/>
      <xs:element ref="art"/>
      <xs:element ref="epigrafe"/>
      <xs:element ref="ementa"/>
      <xs:element ref="preambulo"/>
      <xs:element ref="fecho"/>
      <xs:element ref="assinatura"/>
      <xs:element ref="anexo"/>
      <xs:element ref="ruido"/>
      <xs:element ref="ref"/>
      <xs:element ref="nota"/>
    </xs:choice>
    <xs:attribute name="tipo" type="xs:token" use="optional"/>
    <xs:attribute name="numero" type="xs:token" use="optional"/>
  </xs:complexType>
  <xs:complexType name="t-alteracao" mixed="true">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
